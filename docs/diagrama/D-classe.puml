@startuml
!theme plain
skinparam wrapWidth 220
skinparam maxMessageSize 150
skinparam packageStyle folder
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Agendamento" {
  class AgendamentoController {
    - agendamentoService: AgendamentoService
    + solicitarReserva(dados: SolicitarReservaDTO, ip: String): ReservaDTO
    + cancelarReserva(reservaId: String, usuarioId: String, ip: String): void
    + trocarReserva(reservaAntigaId: String, novosDados: SolicitarReservaDTO, ip: String): ReservaDTO
    + avaliarReservaPendente(reservaId: String, aprovadorId: String, aprovada: boolean, ip: String): ReservaDTO
  }

  class AgendamentoService {
    - reservaService: ReservaService
    - autenticacaoService: IAutenticacaoService
    - auditoriaService: IAuditoriaService
    - gradeService: IGradeAcademicaService
    - notificador: INotificador
    + solicitarReserva(dados: SolicitarReservaDTO, ip: String): ReservaDTO
    + cancelarReserva(reservaId: String, usuarioId: String, ip: String): void
    + trocarReserva(reservaAntigaId: String, novosDados: SolicitarReservaDTO, ip: String): ReservaDTO
    + avaliarReservaPendente(reservaId: String, aprovadorId: String, aprovada: boolean, ip: String): ReservaDTO
    - notificar(usuario: Usuario, reserva: Reserva): void
  }

  class ReservaService {
    - reservaRepository: IReservaRepository
    - politicaReserva: PoliticaReserva
    + criarReserva(usuario: Usuario, sala: Sala, inicio: DateTime, fim: DateTime, qtdPessoas: int, grade: GradeAcademica): Reserva
    + cancelar(reservaId: String, solicitante: Usuario): Reserva
    + substituirAtomicamente(reservaAntigaId: String, usuario: Usuario, novaSala: Sala, inicio: DateTime, fim: DateTime, grade: GradeAcademica): Reserva
    + alterarStatus(reservaId: String, novoStatus: StatusReserva): Reserva
  }

  class PoliticaReserva {
    - politicaRepository: IPoliticaRepository
    - maxHorasReserva: int
    - antecedenciaMinimaMinutos: int
    - toleranciaNoShowMinutos: int
    + validarSolicitacao(usuario: Usuario, sala: Sala, inicio: DateTime, fim: DateTime, qtdPessoas: int, grade: GradeAcademica, reservasSala: List<Reserva>): void
    + validarConflitoAgendaUsuario(inicio: DateTime, fim: DateTime, reservasUsuario: List<Reserva>): void
    + definirStatusInicial(usuario: Usuario, sala: Sala): StatusReserva
    + podeCancelar(reserva: Reserva, solicitante: Usuario, instanteAtual: DateTime): boolean
  }

  class Reserva {
    - id: String
    - horarioInicio: DateTime
    - horarioFim: DateTime
    - status: StatusReserva
    - qtdPessoas: int
    - usuario: Usuario
    - sala: Sala
    + conflitaCom(inicio: DateTime, fim: DateTime): boolean
    + duracaoEmMinutos(): int
    + confirmar(): void
    + rejeitar(): void
    + cancelar(): void
    + estaAtiva(): boolean
  }

  class Sala {
    - id: String
    - codigo: String
    - tipo: TipoAmbiente
    + lotacao: int
    - restrita: boolean
    - bloqueadaManutencao: boolean
    + temCapacidadePara(qtdPessoas: int): boolean
    + estaBloqueada(): boolean
    + exigeAprovacaoTecnica(): boolean
    + alterarBloqueio(status: boolean): void
  }

  interface IReservaRepository <<Interface>> {
    + salvar(reserva: Reserva): Reserva
    + buscarPorId(id: String): Reserva
    + buscarPorSalaEPeriodo(salaId: String, inicio: DateTime, fim: DateTime): List<Reserva>
    + buscarAtivasPorUsuario(usuarioId: String, inicio: DateTime, fim: DateTime): List<Reserva>
    + buscarSalaPorId(salaId: String): Sala
  }

  class ReservaSQLRepository {
    - dbConnection: Connection
    + salvar(reserva: Reserva): Reserva
    + buscarPorId(id: String): Reserva
    + buscarPorSalaEPeriodo(salaId: String, inicio: DateTime, fim: DateTime): List<Reserva>
    + buscarAtivasPorUsuario(usuarioId: String, inicio: DateTime, fim: DateTime): List<Reserva>
    + buscarSalaPorId(salaId: String): Sala
  }

  interface IPoliticaRepository <<Interface>> {
    + obterMaxHorasPorPerfil(perfil: PerfilUsuario): int
    + obterAntecedenciaMinimaMinutos(): int
    + obterToleranciaNoShowMinutos(): int
  }

  class PoliticaSQLRepository {
    - dbConnection: Connection
    + obterMaxHorasPorPerfil(perfil: PerfilUsuario): int
    + obterAntecedenciaMinimaMinutos(): int
    + obterToleranciaNoShowMinutos(): int
  }
}

package "Autenticacao" {
  interface IAutenticacaoService <<Interface>> {
    + validarVinculo(usuarioId: String): Usuario
    + possuiPermissaoGestor(usuarioId: String): boolean
  }

  class Usuario {
    - id: String
    - nome: String
    - email: String
    - telefone: String
    - perfil: PerfilUsuario
    - vinculoAtivo: boolean
    + isVinculoAtivo(): boolean
    + ehDocente(): boolean
    + ehAluno(): boolean
    + podeAprovarLaboratorio(): boolean
  }

  class AutenticacaoService {
    - usuarioRepository: IUsuarioRepository
    + validarVinculo(usuarioId: String): Usuario
    + possuiPermissaoGestor(usuarioId: String): boolean
  }

  interface IUsuarioRepository <<Interface>> {
    + buscarPorId(id: String): Usuario
    + buscarPorEmail(email: String): Usuario
  }

  class UsuarioSQLRepository {
    - dbConnection: Connection
    + buscarPorId(id: String): Usuario
    + buscarPorEmail(email: String): Usuario
  }
}

package "Auditoria" {
  interface IAuditoriaService <<Interface>> {
    + registrar(evento: EventoAuditoria): void
  }

  class AuditoriaService {
    - auditoriaRepository: IAuditoriaRepository
    + registrar(evento: EventoAuditoria): void
  }

  interface IAuditoriaRepository <<Interface>> {
    + salvarLog(evento: EventoAuditoria): void
    + buscarPorEntidade(entidadeId: String): List<EventoAuditoria>
  }

  class AuditoriaSQLRepository {
    - dbConnection: Connection
    + salvarLog(evento: EventoAuditoria): void
    + buscarPorEntidade(entidadeId: String): List<EventoAuditoria>
  }
}

package "IntegracaoAcademica" {
  interface IGradeAcademicaService <<Interface>> {
    + obterGradeDaSala(salaId: String): GradeAcademica
  }

  class GradeAcademicaAdapter {
    - apiEndpoint: String
    - cacheSemestre: Map<String, GradeAcademica>
    + obterGradeDaSala(salaId: String): GradeAcademica
    - buscarNaApiExterna(salaId: String): GradeAcademica
  }

  class GradeAcademica {
    - salaId: String
    - semestreLetivo: String
    - horariosAulas: List<IntervaloHorario>
    + possuiAulaNoHorario(inicio: DateTime, fim: DateTime): boolean
  }
}

package "Notificacao" {
  interface INotificador <<Interface>> {
    + enviarNotificacao(usuario: Usuario, reserva: Reserva): void
  }

  class WhatsAppNotificador {
    - apiToken: String
    + enviarNotificacao(usuario: Usuario, reserva: Reserva): void
  }

  class EmailNotificador {
    - servidorSmtp: String
    + enviarNotificacao(usuario: Usuario, reserva: Reserva): void
  }
}

' === Relações Internas: Agendamento ===
AgendamentoController --> AgendamentoService
AgendamentoService --> ReservaService
ReservaService --> PoliticaReserva
ReservaService --> IReservaRepository
ReservaService ..> Reserva
PoliticaReserva --> IPoliticaRepository
PoliticaReserva ..> Sala
PoliticaReserva ..> Usuario
PoliticaReserva ..> GradeAcademica

Reserva "0..*" --> "1" Sala
Reserva "0..*" --> "1" Usuario

IReservaRepository <|.. ReservaSQLRepository
IPoliticaRepository <|.. PoliticaSQLRepository

' === Relações Inter-Módulos (Sempre via Interfaces) ===
AgendamentoService --> IAutenticacaoService
AgendamentoService --> IAuditoriaService
AgendamentoService --> IGradeAcademicaService
AgendamentoService --> INotificador

' === Relações Internas: Autenticacao ===
IAutenticacaoService ..> Usuario
IAutenticacaoService <|.. AutenticacaoService
AutenticacaoService --> IUsuarioRepository
IUsuarioRepository <|.. UsuarioSQLRepository

' === Relações Internas: Auditoria ===
IAuditoriaService <|.. AuditoriaService
AuditoriaService --> IAuditoriaRepository
IAuditoriaRepository <|.. AuditoriaSQLRepository

' === Relações Internas: IntegracaoAcademica ===
IGradeAcademicaService <|.. GradeAcademicaAdapter
GradeAcademicaAdapter --> GradeAcademica

' === Relações Internas: Notificacao ===
INotificador <|.. WhatsAppNotificador
INotificador <|.. EmailNotificador
@enduml